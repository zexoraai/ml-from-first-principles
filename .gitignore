# Environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Scratch command output at the repo root. Anything worth keeping is copied into evidence/
# first; these patterns are root-anchored so evidence/**/*.txt is unaffected.
/*.log
/bench*.txt
/diag*.txt
/t[0-9].txt
/t[0-9]tail.txt
/tr[0-9].txt
/sm.txt
/ex.txt
/dlist.txt
/dk.txt
/ga.txt
/gs.txt
/gg.txt
/gc.txt
/gl.txt
/gp.txt
/gr.txt
/d[0-9].txt
/env_probe.txt
/tools_probe.txt
/pips.txt
/npmv.txt
/gh.txt
/ep.txt
/cpu.txt
/dps.txt
/vcheck.txt
/v[0-9].txt
# Per-project scratch logs: p2d.txt, p4all.txt, p4s3.txt, c3.txt, cp2.txt, tb2.txt and friends.
# Enumerating exact names proved brittle as the project count grew, so these are prefix patterns.
/p[0-9]*.txt
/c[0-9]*.txt
/cp*.txt
/tb*.txt
/out*.txt
/jsp*.txt

# Datasets: never committed. Each project documents how to regenerate/download.
data/

# Large run artefacts. Checkpoints referenced by EXPERIMENTS.md are committed ONLY if small
# (< 5 MB) and needed by a demo; otherwise they stay local and the record holds the sha256.
runs/
*.pt
*.pth
!docs/**/*.bin

# OS
Thumbs.db
desktop.ini
.DS_Store
